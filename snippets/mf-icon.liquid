{%- comment -%}
  Mango redesign icon set (stroke icons, inherit currentColor).
  Usage: {% render 'mf-icon', icon: 'arrow', size: 16 %}
  Accepts: arrow, check, search, bag, close, truck, hand, ruler, chat, tag, leaf, cube, pin, mail, phone, lock, alert, plus, chevron, user, menu, left, right, filter, zoom, play, instagram, whatsapp
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
-%}
<svg class="mf-icon mf-icon--{{ icon }}{% if icon == 'arrow' %} mf-arrow{% endif %}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  {%- if icon == 'whatsapp' %} fill="currentColor"{% else %} fill="none" stroke="currentColor" stroke-width="1.5"{% endif %}>
  {%- case icon -%}
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6" stroke-width="1.6"/>
    {%- when 'check' -%}<path d="m5 12 4.5 4.5L19 7" stroke-width="1.8"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'hand' -%}<path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12M11 11V4.5a1.5 1.5 0 0 1 3 0V12M14 11V6a1.5 1.5 0 0 1 3 0v8a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L3 14.5a1.6 1.6 0 0 1 2.6-1.8L8 15"/>
    {%- when 'ruler' -%}<path d="m3 16 13-13 5 5L8 21z"/><path d="m7 12 2 2M10 9l2 2M13 6l2 2"/>
    {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/>
    {%- when 'tag' -%}<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.3"/>
    {%- when 'leaf' -%}<path d="M5 19C5 10 10 5 20 4c0 10-5 15-14 15zM5 19l8-8"/>
    {%- when 'cube' -%}<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
    {%- when 'pin' -%}<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
    {%- when 'phone' -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/>
    {%- when 'lock' -%}<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    {%- when 'alert' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.01"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'chevron' -%}<path d="m6 9 6 6 6-6" stroke-width="1.8"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'menu' -%}<path d="M3 7h18M3 12h18M3 17h12"/>
    {%- when 'left' -%}<path d="M15 6l-6 6 6 6" stroke-width="1.6"/>
    {%- when 'right' -%}<path d="m9 6 6 6-6 6" stroke-width="1.6"/>
    {%- when 'filter' -%}<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>
    {%- when 'zoom' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/>
    {%- when 'play' -%}<path d="M8 5v14l11-7z" fill="currentColor" stroke="none"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
    {%- when 'whatsapp' -%}<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.2Z"/>
  {%- endcase -%}
</svg>
