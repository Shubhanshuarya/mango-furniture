{%- comment -%}
  Image side of the sign-in / create-account layout.
  Accepts: image {Object} image_picker value, quote {String}
{%- endcomment -%}
<div class="mf-auth-media">
  {%- if image != blank -%}
    {{- image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: '' -}}
  {%- else -%}
    {{- 'lifestyle-1' | placeholder_svg_tag: 'mf-placeholder-svg' -}}
  {%- endif -%}
  {%- if quote != blank -%}<blockquote>{{ quote | escape }}</blockquote>{%- endif -%}
</div>
