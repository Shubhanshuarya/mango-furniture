{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}

  Theme settings → Cart → "Drawer design" picks the Mango redesign (snippets/mf-cart-drawer.liquid)
  or the original theme drawer (snippets/cart-drawer-classic.liquid). Both keep the same element IDs,
  so assets/cart-drawer.js, assets/cart.js and product forms work with either.
{% endcomment %}
{%- if settings.mf_cart_drawer_style == 'classic' -%}
  {%- render 'cart-drawer-classic' -%}
{%- else -%}
  {%- render 'mf-cart-drawer' -%}
{%- endif -%}
