{%- comment -%}
  Loads the Mango redesign styles/scripts for a section. Safe to render from several sections on one page
  (browsers fetch each URL once). Keeps the redesign self-contained: nothing is added to layout/theme.liquid.
  Accepts:
  - css {String} Optional page-group stylesheet name without extension, e.g. 'mf-home'
  - preload_fonts {Boolean} Preload display + text fonts (use in the first section above the fold)
{%- endcomment -%}
{%- if preload_fonts -%}
  {{ 'mf-fraunces.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'mf-figtree.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}
{{ 'mf-base.css' | asset_url | stylesheet_tag }}
{%- if css != blank -%}
  {{ css | append: '.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'mf-sections.js' | asset_url }}" defer="defer"></script>
