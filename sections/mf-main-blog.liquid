{%- render 'mf-assets', css: 'mf-home', preload_fonts: true -%}
{{ 'mf-pages.css' | asset_url | stylesheet_tag }}

{%- paginate blog.articles by section.settings.per_page -%}
<div class="mf" data-mf-main data-mf-paged data-section-id="{{ section.id }}">
  <section class="mf-container mf-page-hero">
    {%- if section.settings.eyebrow != blank -%}<p class="mf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="mf-display mf-display-xl" style="max-width: 18ch">{{ section.settings.heading | default: blog.title }}</h1>
    {%- if section.settings.intro != blank -%}<div class="mf-lede">{{ section.settings.intro }}</div>{%- endif -%}
  </section>

  {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
    <div class="mf-container">
      <nav class="mf-tabs" aria-label="{{ 'mf.blog.topics' | t }}">
        <a href="{{ blog.url }}"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'mf.blog.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag | escape }}</a>
        {%- endfor -%}
      </nav>
    </div>
  {%- endif -%}

  <section class="mf-container" style="padding-block: var(--space-xl) var(--space-section)">
    {%- if blog.articles.size == 0 -%}
      <div class="mf-empty-state"><h2 class="mf-display mf-display-s">{{ 'mf.blog.empty' | t }}</h2></div>
    {%- else -%}
      <div class="mf-articles mf-articles--list" data-mf-items>
        {%- for article in blog.articles -%}
          {%- assign feature = false -%}
          {%- if forloop.first and paginate.current_page == 1 and section.settings.feature_first -%}{%- assign feature = true -%}{%- endif -%}
          {%- render 'mf-article-card', article: article, index: forloop.index0, feature: feature, show_excerpt: section.settings.show_excerpt -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        {%- assign shown = paginate.current_offset | plus: blog.articles.size -%}
        <div class="mf-pagination" data-mf-pagination>
          <span>{{ 'mf.blog.showing' | t: shown: shown, total: paginate.items }}</span>
          {%- if paginate.next -%}<a class="mf-btn mf-btn--secondary" href="{{ paginate.next.url }}" data-mf-more>{{ 'mf.collection.load_more' | t }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </section>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Mango: Blog",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Defaults to the blog title.", "default": "Where design meets <em>everyday living</em>" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Ideas, inspiration and stories to help you create a home that feels truly yours, from styling tips to behind-the-scenes looks at our craft.</p>" },
    { "type": "checkbox", "id": "show_tags", "label": "Show tag filters", "default": true },
    { "type": "checkbox", "id": "feature_first", "label": "Feature the latest post", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpts", "default": false },
    { "type": "range", "id": "per_page", "label": "Posts per page", "min": 4, "max": 24, "step": 1, "default": 10 }
  ]
}
{% endschema %}
