{%- render 'mf-assets', css: 'mf-home' -%}

<div class="mf mf-section{% if section.settings.background == 'surface' %} mf-section--surface{% endif %}" id="MfServices-{{ section.id }}">
  <div class="mf-container">
    {%- render 'mf-section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
    <div class="mf-services{% if section.settings.columns == '4' %} mf-benefits{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }} class="mf-service mf-reveal" style="--i: {{ forloop.index0 }}"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="mf-ico">{% render 'mf-icon', icon: block.settings.icon %}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          {%- if tag == 'a' and block.settings.link_label != blank -%}
            <span class="mf-link-arrow" style="justify-self: start">{{ block.settings.link_label | escape }} {% render 'mf-icon', icon: 'arrow', size: 16 %}</span>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mango: Service cards",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why buy direct" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Service as considered as the furniture" },
    { "type": "inline_richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "3", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    {
      "type": "select", "id": "background", "label": "Background", "default": "surface",
      "options": [{ "value": "default", "label": "Limewash" }, { "value": "surface", "label": "Plaster" }]
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 8,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "tag",
          "options": [
            { "value": "tag", "label": "Price tag" }, { "value": "truck", "label": "Truck" }, { "value": "chat", "label": "Chat" },
            { "value": "hand", "label": "Hand" }, { "value": "ruler", "label": "Ruler" }, { "value": "leaf", "label": "Leaf" },
            { "value": "cube", "label": "3D cube" }, { "value": "pin", "label": "Location" }, { "value": "lock", "label": "Lock" },
            { "value": "mail", "label": "Mail" }, { "value": "phone", "label": "Phone" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "inline_richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link", "info": "Makes the whole card clickable." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mango: Service cards",
      "blocks": [
        { "type": "card", "settings": { "icon": "tag", "title": "Trade Program", "text": "Exclusive pricing, free fabric swatches and priority support for designers and architects.", "link_label": "Apply" } },
        { "type": "card", "settings": { "icon": "truck", "title": "Shipping & Returns", "text": "Free shipping across the US. Orders are processed in 1–4 business days and arrive in 3–10.", "link_label": "How it works" } },
        { "type": "card", "settings": { "icon": "chat", "title": "Expert Customer Service", "text": "Help by phone, chat or email through every step of designing and shopping.", "link_label": "Get in touch" } }
      ]
    }
  ]
}
{% endschema %}
