{%- render 'mf-assets', css: 'mf-home' -%}

<div class="mf mf-section mf-inverse" id="MfDesignTeaser-{{ section.id }}">
  <div class="mf-container mf-ds-teaser">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="mf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="mf-display mf-display-l">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="mf-lede">{{ section.settings.text }}</div>{%- endif -%}

      {%- assign steps = section.blocks | where: 'type', 'step' -%}
      {%- if steps.size > 0 -%}
        <ol class="mf-steps">
          {%- for block in steps -%}
            <li {{ block.shopify_attributes }}><div><b>{{ block.settings.title | escape }}</b>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}</div></li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.show_form -%}
        {%- assign ds_form_id = 'MfDesignForm-' | append: section.id -%}
        {%- form 'contact', id: ds_form_id, class: 'mf-ds-form', novalidate: 'novalidate' -%}
          {%- if form.posted_successfully? -%}
            <p class="mf-muted" role="status" style="flex-basis: 100%; margin: 0">{% if section.settings.success_message != blank %}{{ section.settings.success_message | escape }}{% else %}{{ 'mf.form.success' | t }}{% endif %}</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="{{ section.settings.form_tag | escape }}">
            <label class="mf-visually-hidden" for="MfDsName-{{ section.id }}">{{ 'mf.form.name' | t }}</label>
            <input class="mf-input" id="MfDsName-{{ section.id }}" name="contact[name]" placeholder="{{ 'mf.form.name' | t }}" autocomplete="name" required>
            <label class="mf-visually-hidden" for="MfDsEmail-{{ section.id }}">{{ 'mf.form.email' | t }}</label>
            <input class="mf-input" id="MfDsEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'mf.form.email' | t }}" autocomplete="email" required
              {%- if form.errors contains 'email' %} aria-invalid="true" aria-describedby="MfDsErr-{{ section.id }}"{% endif %}>
            <button class="mf-btn" type="submit">{{ section.settings.button_label | escape }}</button>
            {%- if form.errors -%}
              <p class="mf-muted" id="MfDsErr-{{ section.id }}" role="alert" style="flex-basis: 100%; margin: 0">{{ 'mf.form.error_heading' | t }} {{ form.errors | default_errors }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      {%- elsif section.settings.button_label != blank -%}
        <p class="mf-mt-l"><a class="mf-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a></p>
      {%- endif -%}
    </div>

    <div class="mf-ds-mosaic">
      {%- for i in (1..3) -%}
        {%- assign key = 'image_' | append: i -%}
        {%- assign img = section.settings[key] -%}
        <div class="mf-m mf-reveal" style="--i: {{ i | minus: 1 }}{% if i > 1 %}; aspect-ratio: 1{% endif %}">
          {%- if img != blank -%}
            {{- img | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 1000, 1200', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy' -}}
          {%- else -%}
            {{- 'collection-2' | placeholder_svg_tag: 'mf-placeholder-svg' -}}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mango: Design teaser",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Design services" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Need an interior designer? <em>We'll take it from here.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Start-to-finish design services that turn a house into a home: customised furniture, bespoke design and quality construction, straight from the maker.</p>" },
    { "type": "header", "content": "Enquiry" },
    { "type": "checkbox", "id": "show_form", "label": "Show quick enquiry form", "default": true, "info": "Submissions arrive as contact form messages in Shopify admin." },
    { "type": "text", "id": "form_tag", "label": "Customer tag for submissions", "default": "design-services" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start a project" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Used when the form is hidden." },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you. Our design team will be in touch soon." },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (tall)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "inline_richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mango: Design teaser",
      "blocks": [
        { "type": "step", "settings": { "title": "Tell us about your space", "text": "Share your room, style and requirements." } },
        { "type": "step", "settings": { "title": "Discovery call", "text": "We talk through your needs and the scope of the project." } },
        { "type": "step", "settings": { "title": "3D renderings and custom pieces", "text": "End-to-end design, then furniture made to fit." } }
      ]
    }
  ]
}
{% endschema %}
