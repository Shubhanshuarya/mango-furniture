{%- render 'mf-assets', css: 'mf-product' -%}

{%- if section.blocks.size > 0 -%}
  <div class="mf mf-section{% if section.settings.background == 'surface' %} mf-section--surface{% endif %}" id="MfFeatureCols-{{ section.id }}">
    <div class="mf-container">
      {%- render 'mf-section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
      <div class="mf-story-band">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <{{ tag }} class="mf-item mf-reveal" style="--i: {{ forloop.index0 }}{% if tag == 'a' %}; text-decoration: none{% endif %}"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="mf-media">{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: '' }}</div>
            {%- endif -%}
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Mango: Feature columns",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The making of" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Built for daily life, <em>finished by hand</em>" },
    { "type": "inline_richtext", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "background", "label": "Background", "default": "surface",
      "options": [{ "value": "default", "label": "Limewash" }, { "value": "surface", "label": "Plaster" }]
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Column title" },
        { "type": "inline_richtext", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mango: Feature columns",
      "blocks": [
        { "type": "column", "settings": { "title": "Solid mango wood", "text": "A dense, richly grained hardwood. Every board has its own figure, so no two pieces are identical." } },
        { "type": "column", "settings": { "title": "Finished by hand", "text": "Joinery, carving and finishing by skilled artisans, one piece at a time." } },
        { "type": "column", "settings": { "title": "Made in Jodhpur", "text": "Shaped and finished in our family workshop in Jodhpur, India." } }
      ]
    }
  ]
}
{% endschema %}
