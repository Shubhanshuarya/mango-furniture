{%- render 'mf-assets' -%}
{{ 'mf-shell.css' | asset_url | stylesheet_tag }}

<div class="mf">
  <footer class="mf-site-footer">
    <div class="mf-container">
      <div class="mf-footer-grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'newsletter' -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<p class="mf-display mf-display-m" style="color: inherit; max-width: 18ch; margin: 0">{{ block.settings.heading }}</p>{%- endif -%}
                {%- assign nl_id = 'MfNewsletter-' | append: section.id -%}
                {%- form 'customer', id: nl_id, class: 'mf-newsletter', novalidate: 'novalidate' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <label class="mf-visually-hidden" for="{{ nl_id }}-email">{{ 'mf.footer.email' | t }}</label>
                  <input id="{{ nl_id }}-email" type="email" name="contact[email]" placeholder="{{ 'mf.footer.email' | t }}" autocomplete="email" required
                    {%- if form.errors %} aria-invalid="true" aria-describedby="{{ nl_id }}-status"{% endif %}>
                  <button class="mf-btn" type="submit">{{ 'mf.footer.subscribe' | t }}</button>
                  {%- if form.posted_successfully? or form.errors -%}
                    <p id="{{ nl_id }}-status" role="status" style="flex-basis: 100%; margin: 6px 0 0; font-size: 13px; opacity: .85">
                      {%- if form.posted_successfully? -%}{{ 'mf.footer.newsletter_success' | t }}{%- else -%}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}{%- endif -%}
                    </p>
                  {%- endif -%}
                {%- endform -%}
                {%- if block.settings.text != blank -%}<p style="font-size: 13px; margin: 10px 0 0; opacity: .75">{{ block.settings.text }}</p>{%- endif -%}
              </div>
            {%- when 'menu' -%}
              {%- assign m = linklists[block.settings.menu] -%}
              <div {{ block.shopify_attributes }}>
                <h4>{{ block.settings.heading | default: m.title | escape }}</h4>
                {%- if m.links.size > 0 -%}
                  {%- assign shown = 0 -%}
                  <ul>
                    {%- for link in m.links -%}
                      {%- if block.settings.flatten and link.links.size > 0 -%}
                        {%- for child in link.links -%}
                          {%- if shown < block.settings.limit -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{%- assign shown = shown | plus: 1 -%}{%- endif -%}
                        {%- endfor -%}
                      {%- elsif shown < block.settings.limit -%}
                        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- assign shown = shown | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- when 'contact' -%}
              <div {{ block.shopify_attributes }}>
                <h4>{{ block.settings.heading | escape }}</h4>
                <ul>
                  {%- if block.settings.email != blank -%}<li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email | escape }}</a></li>{%- endif -%}
                  {%- if block.settings.phone != blank -%}<li><a href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' }}">{{ block.settings.phone | escape }}</a></li>{%- endif -%}
                  {%- liquid
                    assign socials = 'instagram,facebook,pinterest,tiktok,youtube' | split: ','
                    for s in socials
                      assign key = 'social_' | append: s | append: '_link'
                      assign url = settings[key]
                      if url != blank and url != '#'
                        echo '<li><a href="' | append: url | append: '" target="_blank" rel="noopener">'
                        assign label_key = 'mf.footer.' | append: s
                        echo label_key | t
                        echo '</a></li>'
                      endif
                    endfor
                  -%}
                  {%- if block.settings.instagram != blank -%}<li><a href="{{ block.settings.instagram }}" target="_blank" rel="noopener">{{ 'mf.footer.instagram' | t }}</a></li>{%- endif -%}
                </ul>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="mf-footer-base">
        <span>
          © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
          {%- if section.settings.address != blank %} · {{ section.settings.address | escape }}{% endif -%}
          {%- for policy in shop.policies %} · <a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endfor -%}
        </span>
        {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
          <ul class="mf-payments" aria-label="{{ 'mf.footer.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'mf-payment-icon' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Mango: Footer",
  "tag": "section",
  "class": "mf-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "address", "label": "Address line", "default": "919 Garden Hwy, Yuba City, CA 95991" },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Home-décor inspiration and first looks at new arrivals." },
        { "type": "inline_richtext", "id": "text", "label": "Small print" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the menu name." },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
        { "type": "checkbox", "id": "flatten", "label": "Show sub-items of grouped links", "info": "For menus whose top-level items are headings with sub-items.", "default": false },
        { "type": "range", "id": "limit", "label": "Maximum links", "min": 3, "max": 15, "step": 1, "default": 8 }
      ]
    },
    {
      "type": "contact",
      "name": "Contact & social",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Connect" },
        { "type": "text", "id": "email", "label": "Email", "default": "info@mangofurnitureinc.com" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "530-751-0933" },
        { "type": "url", "id": "instagram", "label": "Instagram URL", "info": "Social links from Theme settings → Social media are also shown." }
      ]
    }
  ],
  "presets": [
    { "name": "Mango: Footer", "blocks": [{ "type": "newsletter" }, { "type": "menu" }, { "type": "contact" }] }
  ]
}
{% endschema %}
