{%- render 'mf-assets', css: 'mf-pages' -%}
<div class="mf mf-section{% if section.settings.background == 'surface' %} mf-section--surface{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="mf-container">
    {%- render 'mf-section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text -%}
    <div class="mf-projects">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- else -%}{%- assign tag = 'article' -%}{%- endif -%}
        <{{ tag }} class="mf-project mf-reveal" style="--i: {{ forloop.index0 }}{% if tag == 'a' %}; text-decoration: none{% endif %}"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="mf-media">{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 990px) 33vw, 100vw' }}</div>
          {%- endif -%}
          {%- if block.settings.location != blank -%}<p class="mf-loc">{{ block.settings.location | escape }}</p>{%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Mango: Portfolio",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "projects" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selected projects" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Homes we've designed" },
    { "type": "inline_richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "background", "label": "Background", "default": "surface", "options": [{ "value": "default", "label": "Limewash" }, { "value": "surface", "label": "Plaster" }] }
  ],
  "blocks": [{ "type": "project", "name": "Project", "limit": 9, "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "location", "label": "Location" },
    { "type": "text", "id": "title", "label": "Title", "default": "Project" },
    { "type": "inline_richtext", "id": "text", "label": "Brief" },
    { "type": "url", "id": "link", "label": "Link" }
  ] }],
  "presets": [{ "name": "Mango: Portfolio", "blocks": [{ "type": "project" }, { "type": "project" }, { "type": "project" }] }]
}
{% endschema %}
