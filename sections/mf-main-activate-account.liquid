{%- comment -%}
  Activate account (templates/customers/activate_account.json, classic customer accounts). Native activate_customer_password form.
{%- endcomment -%}
{%- render 'mf-assets', css: 'mf-account', preload_fonts: true -%}
<script src="{{ 'mf-forms.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mf-account.js' | asset_url }}" defer="defer"></script>

<div class="mf" data-mf-main>
  <div class="mf-auth">
    {%- render 'mf-auth-media', image: section.settings.image, quote: section.settings.quote -%}
    <div class="mf-auth-panel">
      <div>
        <section class="mf-auth-form">
          <div>
            <h1 class="mf-display mf-display-l">{{ 'mf.account.activate_title' | t }}</h1>
            <p class="mf-muted" style="margin: 8px 0 0">{{ 'mf.account.activate_text' | t }}</p>
          </div>
          {%- form 'activate_customer_password', id: 'MfPasswordForm', class: 'mf-auth-form', novalidate: 'novalidate', data-mf-validate: 'true', data-mf-match: 'true' -%}
            {%- render 'mf-form-errors', form: form -%}
            <div class="mf-field">
              <label for="MfNewPassword">{{ 'mf.account.new_password' | t }}</label>
              <div style="position: relative">
                <input class="mf-input" id="MfNewPassword" type="password" name="customer[password]" autocomplete="new-password" minlength="5" required aria-describedby="MfNewPasswordHelp" style="padding-right: 72px"{% if form.errors contains 'password' %} aria-invalid="true"{% endif %}>
                <button type="button" class="mf-pw-toggle" aria-pressed="false" aria-controls="MfNewPassword" data-mf-pw-toggle data-show="{{ 'mf.account.show' | t }}" data-hide="{{ 'mf.account.hide' | t }}">{{ 'mf.account.show' | t }}</button>
              </div>
              <p class="mf-help" id="MfNewPasswordHelp" style="margin: 0">{{ 'mf.account.password_hint' | t }}</p>
              <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_new_password' | t }}</p>
            </div>
            <div class="mf-field">
              <label for="MfConfirmPassword">{{ 'mf.account.confirm_password' | t }}</label>
              <input class="mf-input" id="MfConfirmPassword" type="password" name="customer[password_confirmation]" autocomplete="new-password" required data-mf-match-target="MfNewPassword"{% if form.errors contains 'password_confirmation' %} aria-invalid="true"{% endif %}>
              <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_match' | t }}</p>
            </div>
            <button class="mf-btn mf-btn--accent mf-btn--block" type="submit">{{ 'mf.account.activate' | t }}</button>
            <button class="mf-btn mf-btn--secondary mf-btn--block" type="submit" name="decline" formnovalidate data-mf-skip-validate>{{ 'mf.account.decline' | t }}</button>
          {%- endform -%}
        </section>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mango: Activate account",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "quote", "label": "Quote on image", "default": "Your space tells your story." }
  ]
}
{% endschema %}
