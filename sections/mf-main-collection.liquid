{%- comment -%}
  Mango redesign collection page.
  - Filters: whatever is configured in Search & Discovery (collection.filters), list / swatch / price range.
  - Sub-category chips: found automatically in the chosen menu (the group containing this collection).
  - AJAX filtering/sorting/load-more via the Section Rendering API (assets/mf-collection.js);
    without JS the form submits normally and pagination links work.
{%- endcomment -%}
{%- render 'mf-assets', css: 'mf-collection' -%}
<script src="{{ 'mf-collection.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign group = nil
  for parent in menu.links
    if parent.url == collection.url
      assign group = parent
      break
    endif
    for child in parent.links
      if child.url == collection.url
        assign group = parent
        break
      endif
    endfor
    if group
      break
    endif
  endfor
  assign form_id = 'MfFacetForm-' | append: section.id
  assign promos = section.blocks | where: 'type', 'promo'
-%}

{%- paginate collection.products by section.settings.per_page -%}
<div class="mf mf-collection" id="MfCollection-{{ section.id }}" data-mf-collection data-mf-main data-section-id="{{ section.id }}">

  <div class="mf-container mf-coll-hero">
    <div>
      <ol class="mf-crumbs" aria-label="{{ 'mf.collection.breadcrumb' | t }}">
        <li><a href="{{ routes.root_url }}">{{ 'mf.collection.home' | t }}</a></li>
        {%- if group and group.url != collection.url -%}<li><a href="{{ group.url }}">{{ group.title | escape }}</a></li>{%- endif -%}
        <li aria-current="page">{{ collection.title | escape }}</li>
      </ol>
      <h1 class="mf-display mf-display-l" style="margin-top: var(--space-m)">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="mf-lede mf-coll-desc">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- if group and group.links.size > 1 -%}
    <div class="mf-container">
      <nav class="mf-subcats" aria-label="{{ group.title | escape }}">
        {%- if group.url != '#' and group.url != blank -%}
          <a href="{{ group.url }}"{% if group.url == collection.url %} aria-current="page"{% endif %}>{{ 'mf.collection.all_in' | t: title: group.title }}</a>
        {%- endif -%}
        {%- for child in group.links -%}
          {%- assign cimg = child.object.featured_image | default: child.object.image -%}
          <a href="{{ child.url }}"{% if child.url == collection.url %} aria-current="page"{% endif %}>
            {%- if cimg -%}{{ cimg | image_url: width: 96, height: 96, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 36, height: 36 }}{%- endif -%}
            {{ child.title | escape }}
          </a>
        {%- endfor -%}
      </nav>
    </div>
  {%- endif -%}

  <div class="mf-toolbar mf-mt-l">
    <div class="mf-container mf-toolbar-inner">
      <div class="mf-left">
        {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
          <button class="mf-btn mf-btn--secondary mf-btn--sm" type="button" aria-expanded="true" aria-controls="MfFacets-{{ section.id }}" data-mf-filter-toggle>
            {% render 'mf-icon', icon: 'filter', size: 16 %}
            <span class="mf-hide-mobile" data-mf-filter-label data-show="{{ 'mf.collection.show_filters' | t }}" data-hide="{{ 'mf.collection.hide_filters' | t }}">{{ 'mf.collection.hide_filters' | t }}</span>
            <span class="mf-show-mobile">{{ 'mf.collection.filter_sort' | t }}</span>
            <span data-mf-active-count>{%- liquid
              assign active = 0
              for f in collection.filters
                assign active = active | plus: f.active_values.size
                if f.min_value.value != nil or f.max_value.value != nil
                  assign active = active | plus: 1
                endif
              endfor
              if active > 0
                echo '(' | append: active | append: ')'
              endif
            -%}</span>
          </button>
        {%- endif -%}
        <span class="mf-count" data-mf-count aria-live="polite">{{ 'mf.collection.product_count' | t: count: collection.products_count }}</span>
      </div>
      <div class="mf-right">
        {%- if section.settings.enable_sorting -%}
          <label class="mf-select-wrap"><span class="mf-visually-hidden">{{ 'mf.collection.sort_by' | t }}</span>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select class="mf-select" name="sort_by" form="{{ form_id }}" data-mf-sort>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
        <div class="mf-density" role="group" aria-label="{{ 'mf.collection.grid_density' | t }}">
          <button type="button" data-mf-cols="3" aria-pressed="true" aria-label="{{ 'mf.collection.large_grid' | t }}"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6"/><rect x="9" y="1" width="6" height="6"/><rect x="1" y="9" width="6" height="6"/><rect x="9" y="9" width="6" height="6"/></svg></button>
          <button type="button" data-mf-cols="4" aria-pressed="false" aria-label="{{ 'mf.collection.compact_grid' | t }}"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="4" height="4"/><rect x="6" y="1" width="4" height="4"/><rect x="11" y="1" width="4" height="4"/><rect x="1" y="6" width="4" height="4"/><rect x="6" y="6" width="4" height="4"/><rect x="11" y="6" width="4" height="4"/><rect x="1" y="11" width="4" height="4"/><rect x="6" y="11" width="4" height="4"/><rect x="11" y="11" width="4" height="4"/></svg></button>
        </div>
      </div>
    </div>
  </div>

  <div class="mf-container mf-coll-layout{% unless section.settings.enable_filtering and collection.filters.size > 0 %} mf-no-filters{% endunless %}" data-mf-layout>
    {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
      <aside class="mf-facets" id="MfFacets-{{ section.id }}" aria-label="{{ 'mf.collection.filters' | t }}" data-mf-facets>
        <div class="mf-facets-head">
          <h2 class="mf-display mf-display-s">{{ 'mf.collection.filter_sort' | t }}</h2>
          <button class="mf-icon-btn" type="button" data-mf-facets-close aria-label="{{ 'accessibility.close' | t }}">{% render 'mf-icon', icon: 'close' %}</button>
        </div>
        <form id="{{ form_id }}" class="mf-accordion mf-facets-form" action="{{ collection.url }}" method="get" data-mf-facet-form>
          {%- if section.settings.enable_sorting -%}
            <div class="mf-field mf-show-mobile mf-facets-sort">
              <label for="MfSortMobile-{{ section.id }}">{{ 'mf.collection.sort_by' | t }}</label>
              <select class="mf-select" id="MfSortMobile-{{ section.id }}" data-mf-sort-mobile>
                {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          {%- for filter in collection.filters -%}
            {%- assign active_n = filter.active_values.size -%}
            <details{% if forloop.index <= section.settings.open_filters or active_n > 0 %} open{% endif %} data-mf-filter="{{ filter.param_name | escape }}">
              <summary>{{ filter.label | escape }}{% if active_n > 0 %} <span class="mf-muted" style="font-weight: 400">({{ active_n }})</span>{% endif %}<span class="mf-plus" aria-hidden="true"></span></summary>
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="mf-range">
                    <label class="mf-visually-hidden" for="{{ form_id }}-pmin">{{ 'mf.collection.min_price' | t }}</label>
                    <input class="mf-input" id="{{ form_id }}-pmin" type="number" inputmode="numeric" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                      name="{{ filter.min_value.param_name }}" placeholder="{{ cart.currency.symbol }} 0"
                      {%- if filter.min_value.value %} value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %} data-mf-debounce>
                    <span class="mf-muted" aria-hidden="true">–</span>
                    <label class="mf-visually-hidden" for="{{ form_id }}-pmax">{{ 'mf.collection.max_price' | t }}</label>
                    <input class="mf-input" id="{{ form_id }}-pmax" type="number" inputmode="numeric" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                      name="{{ filter.max_value.param_name }}" placeholder="{{ cart.currency.symbol }} {{ filter.range_max | money_without_currency | remove: ',' | round }}"
                      {%- if filter.max_value.value %} value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %} data-mf-debounce>
                  </div>
                {%- else -%}
                  {%- if filter.presentation == 'swatch' -%}
                    <div class="mf-facet-swatches">
                      {%- for value in filter.values -%}
                        {%- assign sw = value.swatch.color | default: '#cfc6b8' -%}
                        <label{% if value.count == 0 and value.active == false %} style="opacity: .45"{% endif %}>
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                          <span class="mf-dot" style="--sw: {{ sw }}"></span>{{ value.label | escape }}
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <ul class="mf-facet-list">
                      {%- for value in filter.values -%}
                        {%- assign vid = form_id | append: '-' | append: filter.param_name | append: '-' | append: forloop.index | handleize -%}
                        <li><label for="{{ vid }}">
                          <input id="{{ vid }}" type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                          <span>{{ value.label | escape }}</span><span class="mf-n">{{ value.count }}</span>
                        </label></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
              {%- endcase -%}
            </details>
          {%- endfor -%}
          <noscript><button class="mf-btn mf-btn--block mf-mt-l" type="submit">{{ 'mf.collection.apply' | t }}</button></noscript>
        </form>
        <div class="mf-facets-foot">
          <a class="mf-btn mf-btn--secondary" href="{{ collection.url }}?sort_by={{ sort_by }}" data-mf-link>{{ 'mf.collection.clear' | t }}</a>
          <button class="mf-btn mf-btn--accent" type="button" data-mf-facets-close data-mf-apply-label="{{ 'mf.collection.show_results' | t: count: '[count]' }}">{{ 'mf.collection.show_results' | t: count: collection.products_count }}</button>
        </div>
      </aside>
    {%- endif -%}

    <div class="mf-coll-main" data-mf-results>
      {%- comment -%} Active filter chips {%- endcomment -%}
      {%- capture chips -%}
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a class="mf-chip" href="{{ value.url_to_remove }}" data-mf-link>{{ value.label | escape }} {% render 'mf-icon', icon: 'close', size: 14 %}<span class="mf-visually-hidden">{{ 'mf.collection.remove_filter' | t }}</span></a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <a class="mf-chip" href="{{ filter.url_to_remove }}" data-mf-link>
                {{- filter.min_value.value | default: 0 | money_without_trailing_zeros }} – {{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros }} {% render 'mf-icon', icon: 'close', size: 14 -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if chips != blank -%}
        <div class="mf-chips">{{ chips }}<a class="mf-chip-clear" href="{{ collection.url }}?sort_by={{ sort_by }}" data-mf-link>{{ 'mf.collection.clear_all' | t }}</a></div>
      {%- endif -%}

      {%- if collection.products.size == 0 -%}
        <div class="mf-empty-state" style="grid-column: 1 / -1">
          <span class="mf-icon-circle">{% render 'mf-icon', icon: 'filter' %}</span>
          <h2 class="mf-display mf-display-s">{{ 'mf.collection.empty_heading' | t }}</h2>
          <p class="mf-muted" style="margin: 0">{{ 'mf.collection.empty_text' | t }}</p>
          <a class="mf-btn" href="{{ collection.url }}" data-mf-link>{{ 'mf.collection.clear_all' | t }}</a>
        </div>
      {%- else -%}
        <h2 class="mf-visually-hidden">{{ 'mf.collection.products_heading' | t: title: collection.title | escape }}</h2>
        <div class="mf-product-grid mf-cols-3" data-mf-grid>
          {%- for product in collection.products -%}
            {%- render 'mf-card-product', product: product, index: forloop.index0, section_id: section.id, sizes: '(min-width: 1200px) 25vw, (min-width: 990px) 30vw, (min-width: 750px) 33vw, calc(50vw - 24px)' -%}
            {%- if paginate.current_page == 1 -%}
              {%- for block in promos -%}
                {%- if block.settings.position == forloop.parentloop.index -%}
                  <a class="mf-promo-tile mf-reveal{% if block.settings.image == blank %} mf-promo-tile--text{% endif %}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}<span class="mf-media">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '', widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw' }}</span>{%- endif -%}
                    <span class="mf-copy">
                      {%- if block.settings.eyebrow != blank -%}<span class="mf-eyebrow" style="color: inherit; opacity: .75; margin: 0">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
                      <span class="mf-display mf-display-m">{{ block.settings.heading | escape }}</span>
                      {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                      {%- if block.settings.link_label != blank -%}<span class="mf-link-arrow" style="justify-self: start">{{ block.settings.link_label | escape }} {% render 'mf-icon', icon: 'arrow', size: 16 %}</span>{%- endif -%}
                    </span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          {%- assign shown_to = paginate.current_offset | plus: collection.products.size -%}
          {%- assign pct = shown_to | times: 100 | divided_by: paginate.items -%}
          <div class="mf-pagination" data-mf-pagination>
            <span>{{ 'mf.collection.showing' | t: shown: shown_to, total: paginate.items }}</span>
            <span class="mf-track"><i style="width: {{ pct }}%"></i></span>
            {%- if paginate.next -%}
              <a class="mf-btn mf-btn--secondary" href="{{ paginate.next.url }}" data-mf-load-more>{{ 'mf.collection.load_more' | t }}</a>
            {%- endif -%}
            {%- if paginate.previous -%}
              <a class="mf-link-arrow" href="{{ paginate.previous.url }}">{{ 'mf.general.previous' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Mango: Collection",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "link_list", "id": "menu", "label": "Menu for breadcrumbs and sub-category chips", "default": "main-menu", "info": "The group containing this collection is shown as chips." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 36, "step": 4, "default": 24 },
    { "type": "header", "content": "Filters & sorting" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true, "info": "Configure filters in the Shopify Search & Discovery app." },
    { "type": "range", "id": "open_filters", "label": "Filter groups open by default", "min": 0, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo tile",
      "limit": 2,
      "settings": [
        { "type": "range", "id": "position", "label": "Show after product", "min": 2, "max": 24, "step": 1, "default": 6 },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Design services" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Need a custom size or finish?" },
        { "type": "text", "id": "text", "label": "Text", "default": "We make pieces to fit your space, with 3D renderings before we build." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Start a project" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
