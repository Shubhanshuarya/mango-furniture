{%- comment -%}
  Create account (templates/customers/register.json, classic customer accounts). Uses the native create_customer form.
{%- endcomment -%}
{%- render 'mf-assets', css: 'mf-account', preload_fonts: true -%}
<script src="{{ 'mf-forms.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mf-account.js' | asset_url }}" defer="defer"></script>

<div class="mf" data-mf-main>
  <div class="mf-auth">
    {%- render 'mf-auth-media', image: section.settings.image, quote: section.settings.quote -%}
    <div class="mf-auth-panel">
      <div>
        <nav class="mf-tabs" aria-label="{{ 'mf.account.tabs' | t }}">
          <a href="{{ routes.account_login_url }}">{{ 'mf.account.sign_in' | t }}</a>
          <a href="{{ routes.account_register_url }}" aria-current="page">{{ 'mf.account.create_account' | t }}</a>
        </nav>

        <section class="mf-auth-form">
          <div>
            <h1 class="mf-display mf-display-l">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'mf.account.register_title' | t }}{% endif %}</h1>
            {%- if section.settings.text != blank -%}<p class="mf-muted" style="margin: 8px 0 0">{{ section.settings.text }}</p>{%- endif -%}
          </div>

          {%- form 'create_customer', id: 'MfRegisterForm', class: 'mf-auth-form', novalidate: 'novalidate', data-mf-validate: 'true' -%}
            {%- render 'mf-form-errors', form: form -%}
            <div class="mf-form-row">
              <div class="mf-field">
                <label for="MfRegFirst">{{ 'mf.account.first_name' | t }}</label>
                <input class="mf-input" id="MfRegFirst" name="customer[first_name]" autocomplete="given-name" required value="{{ form.first_name }}">
                <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_required' | t }}</p>
              </div>
              <div class="mf-field">
                <label for="MfRegLast">{{ 'mf.account.last_name' | t }}</label>
                <input class="mf-input" id="MfRegLast" name="customer[last_name]" autocomplete="family-name" required value="{{ form.last_name }}">
                <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_required' | t }}</p>
              </div>
            </div>
            <div class="mf-field">
              <label for="MfRegEmail">{{ 'mf.account.email' | t }}</label>
              <input class="mf-input" id="MfRegEmail" type="email" name="customer[email]" autocomplete="email" autocapitalize="off" autocorrect="off" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
              <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_email' | t }}</p>
            </div>
            <div class="mf-field">
              <label for="MfRegPassword">{{ 'mf.account.password' | t }}</label>
              <div style="position: relative">
                <input class="mf-input" id="MfRegPassword" type="password" name="customer[password]" autocomplete="new-password" minlength="5" required aria-describedby="MfRegPasswordHelp" style="padding-right: 72px"{% if form.errors contains 'password' %} aria-invalid="true"{% endif %}>
                <button type="button" class="mf-pw-toggle" aria-pressed="false" aria-controls="MfRegPassword" data-mf-pw-toggle data-show="{{ 'mf.account.show' | t }}" data-hide="{{ 'mf.account.hide' | t }}">{{ 'mf.account.show' | t }}</button>
              </div>
              <p class="mf-help" id="MfRegPasswordHelp" style="margin: 0">{{ 'mf.account.password_hint' | t }}</p>
              <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_new_password' | t }}</p>
            </div>
            {%- if section.settings.show_marketing -%}
              <label class="mf-check"><input type="checkbox" name="customer[accepts_marketing]" value="true"> {{ 'mf.account.marketing' | t }}</label>
            {%- endif -%}
            <button class="mf-btn mf-btn--accent mf-btn--block" type="submit">{{ 'mf.account.create_account' | t }}</button>
          {%- endform -%}

          <p class="mf-auth-note">{{ 'mf.account.have_account' | t }} <a href="{{ routes.account_login_url }}">{{ 'mf.account.sign_in' | t }}</a></p>
        </section>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mango: Create account",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "quote", "label": "Quote on image", "default": "Your space tells your story." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create an account" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Faster checkout and order tracking." },
    { "type": "checkbox", "id": "show_marketing", "label": "Show email sign-up checkbox", "default": true }
  ]
}
{% endschema %}
