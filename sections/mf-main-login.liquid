{%- comment -%}
  Sign in (templates/customers/login.json, classic customer accounts).
  Keeps the theme's login logic: customer_login (password only when form.password_needed),
  recover_customer_password (panel opens on #recover, after an error or after success), guest_login.
{%- endcomment -%}
{%- render 'mf-assets', css: 'mf-account', preload_fonts: true -%}
<script src="{{ 'mf-forms.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mf-account.js' | asset_url }}" defer="defer"></script>

<div class="mf" data-mf-main>
  <div class="mf-auth">
    {%- render 'mf-auth-media', image: section.settings.image, quote: section.settings.quote -%}
    <div class="mf-auth-panel">
      <div>
        <nav class="mf-tabs" aria-label="{{ 'mf.account.tabs' | t }}">
          <a href="{{ routes.account_login_url }}" aria-current="page">{{ 'mf.account.sign_in' | t }}</a>
          <a href="{{ routes.account_register_url }}">{{ 'mf.account.create_account' | t }}</a>
        </nav>

        {%- comment -%} Password recovery. Rendered first so its result is known before the login panel. {%- endcomment -%}
        {%- capture recover_panel -%}
          {%- form 'recover_customer_password', id: 'MfRecoverForm', class: 'mf-auth-form', novalidate: 'novalidate', data-mf-validate: 'true' -%}
            {%- assign recover_success = form.posted_successfully? -%}
            {%- assign recover_error = false -%}
            {%- if form.errors -%}{%- assign recover_error = true -%}{%- endif -%}
            <div>
              <h1 class="mf-display mf-display-m" tabindex="-1">{{ 'mf.account.reset_title' | t }}</h1>
              <p class="mf-muted" style="margin: 6px 0 0">{{ 'mf.account.reset_text' | t }}</p>
            </div>
            {%- render 'mf-form-errors', form: form -%}
            <div class="mf-field">
              <label for="MfRecoverEmail">{{ 'mf.account.email' | t }}</label>
              <input class="mf-input" id="MfRecoverEmail" type="email" name="email" autocomplete="email" autocapitalize="off" autocorrect="off" required{% if form.errors %} aria-invalid="true"{% endif %}>
              <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_email' | t }}</p>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap">
              <button class="mf-btn mf-btn--accent" type="submit">{{ 'mf.account.send_link' | t }}</button>
              <a class="mf-btn mf-btn--secondary" href="#login" data-mf-recover-close>{{ 'mf.account.cancel' | t }}</a>
            </div>
          {%- endform -%}
        {%- endcapture -%}

        <section class="mf-auth-form" id="login" data-mf-login-panel{% if recover_error %} hidden{% endif %}>
          <div>
            <h1 class="mf-display mf-display-l">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'mf.account.welcome_back' | t }}{% endif %}</h1>
            {%- if section.settings.text != blank -%}<p class="mf-muted" style="margin: 8px 0 0">{{ section.settings.text }}</p>{%- endif -%}
          </div>

          {%- if recover_success -%}
            <div class="mf-auth-success" role="status" tabindex="-1" data-mf-autofocus>{% render 'mf-icon', icon: 'mail', size: 20 %}<span>{{ 'mf.account.reset_sent' | t }}</span></div>
          {%- endif -%}

          {%- form 'customer_login', id: 'MfLoginForm', class: 'mf-auth-form', novalidate: 'novalidate', data-mf-validate: 'true' -%}
            {%- render 'mf-form-errors', form: form -%}
            <div class="mf-field">
              <label for="MfLoginEmail">{{ 'mf.account.email' | t }}</label>
              <input class="mf-input" id="MfLoginEmail" type="email" name="customer[email]" autocomplete="email" autocapitalize="off" autocorrect="off" required{% if form.errors contains 'form' %} aria-invalid="true"{% endif %}>
              <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_email' | t }}</p>
            </div>
            {%- if form.password_needed -%}
              <div class="mf-field">
                <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px">
                  <label for="MfLoginPassword">{{ 'mf.account.password' | t }}</label>
                  <a href="#recover" style="font-size: var(--step--1)" data-mf-recover-open>{{ 'mf.account.forgot' | t }}</a>
                </div>
                <div style="position: relative">
                  <input class="mf-input" id="MfLoginPassword" type="password" name="customer[password]" autocomplete="current-password" required style="padding-right: 72px"{% if form.errors contains 'form' %} aria-invalid="true"{% endif %}>
                  <button type="button" class="mf-pw-toggle" aria-pressed="false" aria-controls="MfLoginPassword" data-mf-pw-toggle data-show="{{ 'mf.account.show' | t }}" data-hide="{{ 'mf.account.hide' | t }}">{{ 'mf.account.show' | t }}</button>
                </div>
                <p class="mf-field-error">{% render 'mf-icon', icon: 'alert', size: 16 %}{{ 'mf.account.error_password' | t }}</p>
              </div>
            {%- endif -%}
            <button class="mf-btn mf-btn--accent mf-btn--block" type="submit">{{ 'mf.account.sign_in' | t }}</button>
          {%- endform -%}

          <p class="mf-auth-note">{{ 'mf.account.new_here' | t }} <a href="{{ routes.account_register_url }}">{{ 'mf.account.create_account' | t }}</a></p>
          {%- if section.settings.note != blank -%}<p class="mf-auth-note">{{ section.settings.note }}</p>{%- endif -%}

          {%- if shop.checkout.guest_login -%}
            <div class="mf-auth-guest">
              <h2 class="mf-display mf-display-s">{{ 'mf.account.guest_title' | t }}</h2>
              {%- form 'guest_login' -%}
                <button class="mf-btn mf-btn--secondary mf-btn--block" type="submit">{{ 'mf.account.guest_button' | t }}</button>
              {%- endform -%}
            </div>
          {%- endif -%}
        </section>

        <section id="recover" data-mf-recover-panel{% unless recover_error %} hidden{% endunless %}>
          {{ recover_panel }}
        </section>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mango: Sign in",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "quote", "label": "Quote on image", "default": "Your space tells your story." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome back" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Track your orders, save addresses and check out faster." },
    { "type": "inline_richtext", "id": "note", "label": "Note under the form", "default": "Trade member? Sign in with your trade account to see your pricing." }
  ]
}
{% endschema %}
