{%- render 'mf-assets' -%}
{%- if section.blocks.size > 0 -%}
  <div class="mf mf-announcement" role="region" aria-label="{{ 'mf.announcement.label' | t }}">
    <div class="mf-announcement-rotator" data-mf-rotate="{{ section.settings.speed }}">
      {%- for block in section.blocks -%}
        <p style="margin: 0"{% unless forloop.first %} aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
          {%- if block.settings.text_desktop != blank -%}<span class="mf-hide-mobile"> <span aria-hidden="true">·</span> {{ block.settings.text_desktop | escape }}</span>{%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Mango: Announcement",
  "tag": "section",
  "class": "mf-announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "range", "id": "speed", "label": "Rotate every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5, "info": "Used when there is more than one message." }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping across the US" },
        { "type": "text", "id": "text_desktop", "label": "Extra text on desktop", "default": "Handcrafted in solid mango wood" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Mango: Announcement", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
