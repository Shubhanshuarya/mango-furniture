{%- render 'mf-assets', css: 'mf-home' -%}

<div class="mf mf-section--tight" id="MfBento-{{ section.id }}">
  <div class="mf-container">
    {%- render 'mf-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      link_label: section.settings.link_label,
      link_url: section.settings.link_url
    -%}

    <div class="mf-bento">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection_item = block.settings.collection
          assign label = block.settings.label | default: collection_item.title
          assign tile_image = block.settings.image | default: collection_item.featured_image
          assign url = collection_item.url | default: block.settings.link | default: routes.collections_url
          case block.settings.size
            when 'tall'
              assign size_class = ' mf-tile--tall'
              assign img_sizes = '(min-width: 990px) 25vw, 50vw'
            when 'wide'
              assign size_class = ' mf-tile--wide'
              assign img_sizes = '(min-width: 990px) 50vw, 100vw'
            else
              assign size_class = ''
              assign img_sizes = '(min-width: 990px) 25vw, 50vw'
          endcase
          assign stagger = forloop.index0 | modulo: 6
        -%}
        <a class="mf-tile{{ size_class }} mf-reveal" style="--i: {{ stagger }}" href="{{ url }}" {{ block.shopify_attributes }}>
          {%- if tile_image != blank -%}
            {{- tile_image | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 1000, 1400', sizes: img_sizes, loading: 'lazy', alt: '' -}}
          {%- else -%}
            {{- 'collection-1' | placeholder_svg_tag: 'mf-placeholder-svg' -}}
          {%- endif -%}
          <span class="mf-tile-label">
            <span>{{ label | default: 'Collection' | escape }}</span>
            <span>{% render 'mf-icon', icon: 'arrow', size: 16 %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mango: Category bento",
  "tag": "section",
  "class": "mf-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Pieces for every room" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All furniture" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "url", "id": "link", "label": "Link", "info": "Used only when no collection is selected." },
        {
          "type": "select", "id": "size", "label": "Tile size", "default": "normal",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "tall", "label": "Tall (2 rows)" },
            { "value": "wide", "label": "Wide (2 columns)" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Mango: Category bento",
      "blocks": [
        { "type": "category", "settings": { "size": "tall" } },
        { "type": "category" },
        { "type": "category", "settings": { "size": "wide" } },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
