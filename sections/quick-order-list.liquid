{{ 'section-quick-order-list.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<script src="{{ 'section-quick-order-list.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign items_in_cart = cart | line_items_for: product | sum: 'quantity'
  assign remove_button_label = 'sections.quick-order-list.remove_all' | t
  assign cancel_button_label = 'sections.quick-order-list.cancel' | t
%}

<div
  class="
    section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}
    {%- if section.settings.enable_border_top %} section_border_top{% endif -%}
    {%- if section.settings.enable_border_bottom %} section_border_bottom{% endif -%}
  "
>
  <div class="container">
    <quick-order-list
      class="quick-order-list"
      id="{{ section.id }}-{{ product.id }}"
      data-section="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-url="{{ product.url }}"
    >
      <form
        action="{{ routes.cart_update_url }}"
        class="quick-order-list__form"
        method="post"
        id="QuickOrderList"
      >
        {%- paginate product.variants by section.settings.variants_per_page -%}
          <div class="quick-order-list__container">
            <table class="quick-order-list__table">
              <caption class="visually-hidden">
                {{- 'sections.cart.caption' | t -}}
              </caption>
              <thead>
                <tr>
                  <th scope="col">
                    <span class="quick-order-list__heading caption-with-letter-spacing">
                      {%- if product.has_only_default_variant -%}
                        {{- 'sections.cart.headings.product' | t -}}
                      {%- else -%}
                        {{- 'sections.quick-order-list.heading_variant' | t -}}
                      {%- endif -%}
                    </span>
                  </th>
                  <th scope="col">
                    <span class="quick-order-list__heading caption-with-letter-spacing">
                      {{- 'sections.cart.headings.quantity' | t -}}
                    </span>
                  </th>
                  <th class="quick-order-list-item" scope="col">
                    <span class="quick-order-list__heading caption-with-letter-spacing">
                      {{- 'sections.cart.headings.price' | t -}}
                    </span>
                  </th>
                  <th class="quick-order-list-item" scope="col">
                    <span class="quick-order-list__heading caption-with-letter-spacing">
                      {%- if product.has_only_default_variant -%}
                        {{- 'sections.quick-order-list.product_total' | t -}}
                      {%- else -%}
                        {{- 'sections.quick-order-list.variant_total' | t -}}
                      {%- endif -%}
                    </span>
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- if product.has_only_default_variant -%}
                  {%- render 'quick-order-list-row',
                    item: product,
                    variant: product.selected_or_first_available_variant,
                    settings: section.settings
                  -%}
                {%- else -%}
                  {%- for variant in product.variants -%}
                    {%- render 'quick-order-list-row', item: variant, variant: variant, settings: section.settings -%}
                  {%- endfor -%}
                {%- endif -%}
              </tbody>
            </table>
          </div>

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}

        <p
          class="visually-hidden"
          id="quick-order-list-live-region-text-{{ product.id }}"
          aria-live="polite"
          role="status"
        ></p>
        <p
          class="visually-hidden"
          id="shopping-cart-variant-item-status"
          aria-live="polite"
          aria-hidden="true"
          role="status"
        >
          {{- 'accessibility.loading' | t -}}
        </p>
      </form>

      {%- if product.has_only_default_variant or product.variants_count == 1 -%}
        <span class="quick-order-list__error"></span>
      {%- else -%}
        <div
          class="quick-order-list__total"
          id="quick-order-list-total-{{ product.id }}-{{ section.id }}"
        >
          <div class="quick-order-list__total-info">
            <div class="quick-order-list__total-left">
              <div class="quick-order-list__total-buttons">
                {% assign cart_button_label = 'sections.quick-order-list.view_cart' | t %}
                {% render 'button', btn_label: cart_button_label, btn_style: 'primary', btn_link: routes.cart_url %}

                <div class="quick-order-list__remove-all">
                  <div class="loading-overlay__spinner hidden">
                    {%- render 'icon-loading' -%}
                  </div>

                  <quick-order-list-remove-all-button
                    data-action="confirm"
                    class="{% if items_in_cart == 0 %}hidden{% endif %}"
                  >
                    <button class="button button--simple" type="button">
                      <span>
                        <span class="button-label">{{ remove_button_label }}</span>
                        <span class="button-label">{{ remove_button_label }}</span>
                      </span>
                    </button>
                  </quick-order-list-remove-all-button>
                </div>
              </div>
              <span class="quick-order-list__error"></span>
            </div>
            <div class="quick-order-list__total-count">
              <span class="quick-order-list__total-label caption-with-letter-spacing">
                {{- 'sections.quick-order-list.total_items' | t -}}
              </span>
              <span class="price">{{ items_in_cart }}</span>
            </div>
            <div class="quick-order-list__total-price">
              <div class="quick-order-list__total-subtotal">
                <span class="quick-order-list__total-label caption-with-letter-spacing">
                  {{- 'sections.quick-order-list.product_total' | t -}}
                </span>
                <span class="price">
                  {{ cart | line_items_for: product | sum: 'original_line_price' | money }}
                </span>
              </div>
              <span class="tax-note caption">
                {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                  {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- elsif cart.taxes_included -%}
                  {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                {%- elsif shop.shipping_policy.body != blank -%}
                  {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                {%- else -%}
                  {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                {%- endif -%}
              </span>
            </div>
          </div>

          <div class="quick-order-list__total-confirmation hidden">
            <span class="caption">
              {{- 'sections.quick-order-list.remove_all_items_confirmation' | t: quantity: items_in_cart -}}
            </span>

            <quick-order-list-remove-all-button data-action="remove">
              <button class="button button--primary" type="button">
                <span class="button-label">{{ remove_button_label }}</span>
              </button>
            </quick-order-list-remove-all-button>

            <quick-order-list-remove-all-button data-action="cancel">
              <button class="button button--simple" type="button">
                <span>
                  <span class="button-label">{{ cancel_button_label }}</span>
                  <span class="button-label">{{ cancel_button_label }}</span>
                </span>
              </button>
            </quick-order-list-remove-all-button>
          </div>

          <script type="application/json" data-cart-contents>
            {{ cart | line_items_for: product | map: "variant_id" | json }}
          </script>
        </div>
      {%- endif -%}
    </quick-order-list>

    <template id="QuickOrderListErrorTemplate-{{ product.id }}">
      {% render 'icon-error' %}
      <span class="quick-order-list__error-message caption" role="alert"></span>
    </template>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.quick-order-list.name",
  "tag": "section",
  "class": "quick-order-list-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "range",
      "id": "variants_per_page",
      "min": 5,
      "max": 50,
      "step": 1,
      "default": 50,
      "label": "t:sections.quick-order-list.settings.variants_per_page.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.quick-order-list.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.quick-order-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.quick-order-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.quick-order-list.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.quick-order-list.settings.image_ratio.label",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "select",
      "id": "image_fit",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.quick-order-list.settings.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.quick-order-list.settings.image_fit.options__2.label"
        }
      ],
      "default": "cover",
      "label": "t:sections.quick-order-list.settings.image_fit.label",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "default": false,
      "label": "t:sections.quick-order-list.settings.show_sku.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.border.header.content"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "default": false,
      "label": "t:sections.all.border.border_enable_top.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_bottom",
      "default": false,
      "label": "t:sections.all.border.border_enable_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.quick-order-list.presets.default",
      "category": "t:sections.categories.products"
    }
  ]
}
{% endschema %}
