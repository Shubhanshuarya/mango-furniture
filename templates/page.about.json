        "db1f9228-8e89-4592-855b-7bf8a842e21d": {
          "type": "text",
          "settings": {
            "text": "<p>Our journey began with a simple idea: to merge timeless elegance with contemporary fashion. Each item in our store is carefully selected to ensure it meets our high standards for craftsmanship, durability, and style. Beyond just selling clothes, we are dedicated to building a community of fashion enthusiasts who value quality, creativity, and ethical production. </p>",
            "text_color": "heading",
            "text_size": "small",
            "container_size": "small",
            "text_horizontal": "left"
          }
        }
